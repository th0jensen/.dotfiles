#!/usr/bin/env bash
set -euo pipefail

mode=floating
split=below
ratio=25
wait_mode=0
label=""

usage() {
  cat >&2 <<'EOF'
Usage: rerp [options] COMMAND [ARGS...]

Run COMMAND in an ephemeral Rex pane.

Defaults:
  - floating pane (good for tests and quick commands)
  - use --tiled for deploy/run/handoff terminals (default below)
  - use --right/--beside for a pane next to the agent (PRs, browser)

Options:
  --float|--floating        floating pane (default)
  --tiled|--tile|--deploy   tiled pane
  --right|--beside|--handoff tiled pane to the right/beside the agent
  --below                   tiled pane below the agent (default tiled placement)
  --ratio NUM               tiled split ratio (default 25)
  --wait                    wait for command exit and capture output
  --label TEXT              pane label
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --float|--floating) mode=floating; shift ;;
    --tiled|--tile|--deploy) mode=tiled; split=below; shift ;;
    --right|--beside|--handoff) mode=tiled; split=right; shift ;;
    --below) mode=tiled; split=below; shift ;;
    --ratio) ratio="${2:?}"; shift 2 ;;
    --wait) wait_mode=1; shift ;;
    --label) label="${2:?}"; shift 2 ;;
    --) shift; break ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  # Bare rerp opens an interactive floating shell in the caller's window.
  set -- "${SHELL:-/bin/bash}"
fi

if [[ -z "${REX_SESSION:-}" || -z "${REX_BLOCK:-}" ]]; then
  echo "rerp: REX_SESSION/REX_BLOCK not set (not running in Rex)" >&2
  exit 1
fi

command_name="$1"
if [[ -z "$label" ]]; then
  label="rerp: $command_name"
fi

cwd="$PWD"

case "$mode" in
  tiled)
    set +e
    caller_window=$(rex block inspect "$REX_BLOCK" --json 2>/dev/null | jq -r '.block.window_id // empty')
    window_arg=()
    [[ -n "$caller_window" ]] && window_arg=(-w "$caller_window")
    if (( wait_mode == 1 )); then
      out=$(rex run -s "$REX_SESSION" -b "$REX_BLOCK" \
        "${window_arg[@]}" \
        --split="$split" --ratio "$ratio" --focus=false \
        --keep-open --wait --json --label "$label" -c "$cwd" -- "$@" 2>&1)
    else
      out=$(rex run -s "$REX_SESSION" -b "$REX_BLOCK" \
        "${window_arg[@]}" \
        --split="$split" --ratio "$ratio" --focus=false \
        --keep-open --json --label "$label" -c "$cwd" -- "$@" 2>&1)
    fi
    status=$?
    set -e
    blk=$(printf '%s\n' "$out" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
    if [[ -z "$blk" ]]; then
      printf '%s\n' "$out" >&2
      exit 1
    fi
    if (( wait_mode == 1 )); then
      rex capture -s "$REX_SESSION" -b "$blk" --trim 2>&1 || true
    else
      # Give a brief head start for initial output.
      sleep 0.3
      rex capture -s "$REX_SESSION" -b "$blk" --trim 2>&1 || true
    fi
    echo "rerp: tiled pane block=$blk"
    exit "$status"
    ;;
  floating)
    caller_window=$(rex block inspect "$REX_BLOCK" --json 2>/dev/null | jq -r '.block.window_id // empty')
    is_interactive=0
    if [[ "$command_name" == "${SHELL:-/bin/bash}" && $# -eq 1 && -z "${RERP_FORCE_WRAP:-}" ]]; then
      is_interactive=1
    fi

    if (( is_interactive == 1 )); then
      set +e
      payload=$(jq -nc --arg session "$REX_SESSION" --arg window "$caller_window" --arg cwd "$cwd" --arg label "$label" '{
        session_id: $session,
        window_id: (if $window == "" then null else $window end),
        bounds: [0.15, 0.1, 0.7, 0.5],
        layout: { block: { flavor: "com.superlogical.terminal.shell", label: $label, options: { cwd: $cwd } } },
        focus: false
      }')
      out=$(printf '%s' "$payload" | rex api call session.new_layer - 2>&1)
      status=$?
      set -e
      blk=$(printf '%s\n' "$out" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
      layer=$(printf '%s\n' "$out" | jq -r '.layer_id // empty' 2>/dev/null || true)
      if [[ -z "$blk" ]]; then
        printf '%s\n' "$out" >&2
        exit 1
      fi
      echo "rerp: floating shell layer=$layer block=$blk"
      exit 0
    fi

    script='cd -- "$1" || exit 1; shift; "$@"; rc=$?; printf "\n__RERP_EXIT__=%s\n" "$rc"; exit "$rc"'
    cmd_json=$(printf '%s\n' "bash" "-c" "$script" "rerp" "$cwd" "$@" | jq -R . | jq -s .)

    set +e
    payload=$(jq -nc --arg session "$REX_SESSION" --arg window "$caller_window" --arg cwd "$cwd" --arg label "$label" --argjson cmd "$cmd_json" '{
      session_id: $session,
      window_id: (if $window == "" then null else $window end),
      bounds: [0.15, 0.1, 0.7, 0.5],
      layout: { block: { flavor: "com.superlogical.terminal.shell", label: $label, options: { command: $cmd, cwd: $cwd, exit: { on_completion: false } } } },
      focus: false
    }')
    out=$(printf '%s' "$payload" | rex api call session.new_layer - 2>&1)
    status=$?
    set -e
    blk=$(printf '%s\n' "$out" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
    layer=$(printf '%s\n' "$out" | jq -r '.layer_id // empty' 2>/dev/null || true)
    if [[ -z "$blk" ]]; then
      printf '%s\n' "$out" >&2
      exit 1
    fi

    exit_status=124
    deadline=$((SECONDS + 60))
    captured=""
    while (( SECONDS < deadline )); do
      captured=$(rex capture -s "$REX_SESSION" -b "$blk" --trim 2>/dev/null || true)
      if printf '%s\n' "$captured" | grep -q '^__RERP_EXIT__='; then
        exit_status=$(printf '%s\n' "$captured" | sed -n 's/^__RERP_EXIT__=//p' | tail -n 1)
        break
      fi
      sleep 0.2
    done

    printf '%s\n' "$captured" | grep -v '^__RERP_EXIT__='
    rex block close -s "$REX_SESSION" "$blk" >/dev/null 2>&1 || true
    echo "rerp: floating exit=$exit_status block=$blk layer=$layer"
    exit "${exit_status:-1}"
    ;;
esac
