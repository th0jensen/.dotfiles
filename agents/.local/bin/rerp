#!/usr/bin/env bash
set -euo pipefail

mode=floating
split=below
ratio=25
wait_mode=0
label=""

usage() {
  cat >&2 <<'EOF'
Usage: rerp [options] COMMAND [ARGS...]

Run COMMAND in an ephemeral Rex pane.

Defaults:
  - floating pane (good for tests and quick commands)
  - use --tiled for deploy/run/handoff terminals (default below)
  - use --right/--beside for a pane next to the agent (PRs, browser)

Options:
  --float|--floating        floating pane (default)
  --tiled|--tile|--deploy   tiled pane
  --right|--beside|--handoff tiled pane to the right/beside the agent
  --below                   tiled pane below the agent (default tiled placement)
  --ratio NUM               tiled split ratio (default 25)
  --wait                    wait for command exit and capture output
  --label TEXT              pane label
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --float|--floating) mode=floating; shift ;;
    --tiled|--tile|--deploy) mode=tiled; split=below; shift ;;
    --right|--beside|--handoff) mode=tiled; split=right; shift ;;
    --below) mode=tiled; split=below; shift ;;
    --ratio) ratio="${2:?}"; shift 2 ;;
    --wait) wait_mode=1; shift ;;
    --label) label="${2:?}"; shift 2 ;;
    --) shift; break ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

if [[ -z "${REX_SESSION:-}" || -z "${REX_BLOCK:-}" ]]; then
  echo "rerp: REX_SESSION/REX_BLOCK not set (not running in Rex)" >&2
  exit 1
fi

command_name="$1"
if [[ -z "$label" ]]; then
  label="rerp: $command_name"
fi

cwd="$PWD"

case "$mode" in
  tiled)
    set +e
    caller_window=$(rex block inspect "$REX_BLOCK" --json 2>/dev/null | jq -r '.block.window_id // empty')
    window_arg=()
    [[ -n "$caller_window" ]] && window_arg=(-w "$caller_window")
    if (( wait_mode == 1 )); then
      out=$(rex run -s "$REX_SESSION" -b "$REX_BLOCK" \
        "${window_arg[@]}" \
        --split="$split" --ratio "$ratio" --focus=false \
        --keep-open --wait --json --label "$label" -c "$cwd" -- "$@" 2>&1)
    else
      out=$(rex run -s "$REX_SESSION" -b "$REX_BLOCK" \
        "${window_arg[@]}" \
        --split="$split" --ratio "$ratio" --focus=false \
        --keep-open --json --label "$label" -c "$cwd" -- "$@" 2>&1)
    fi
    status=$?
    set -e
    blk=$(printf '%s\n' "$out" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
    if [[ -z "$blk" ]]; then
      printf '%s\n' "$out" >&2
      exit 1
    fi
    if (( wait_mode == 1 )); then
      rex capture -s "$REX_SESSION" -b "$blk" --trim 2>&1 || true
    else
      # Give a brief head start for initial output.
      sleep 0.3
      rex capture -s "$REX_SESSION" -b "$blk" --trim 2>&1 || true
    fi
    echo "rerp: tiled pane block=$blk"
    exit "$status"
    ;;
  floating)
    set +e
    out=$(rex run --wait --keep-open --json --focus=false \
      --label "$label" -c "$cwd" -- "$@" 2>&1)
    status=$?
    set -e
    blk=$(printf '%s\n' "$out" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
    if [[ -z "$blk" ]]; then
      printf '%s\n' "$out" >&2
      exit 1
    fi
    rex capture -s "$REX_SESSION" -b "$blk" --trim 2>&1 || true
    rex block close -s "$REX_SESSION" "$blk" >/dev/null 2>&1 || true
    echo "rerp: floating exit=$status block=$blk"
    exit "$status"
    ;;
esac
