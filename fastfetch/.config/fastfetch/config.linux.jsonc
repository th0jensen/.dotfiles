{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "green" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": " Linux",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "auto",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "useAvailable": true,
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green",
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "blue",
      "format": "{pacman} (pacman)",
    },
    {
      "type": "de",
      "key": "│ ├󰧨",
      "keyColor": "blue",
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐",
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "birth=$(stat -c %W / 2>/dev/null); if [ -z \"$birth\" ] || [ \"$birth\" = \"0\" ] || [ \"$birth\" = \"-1\" ]; then echo \"unknown\"; else echo \"$((($(date +%s) - birth) / 86400)) days\"; fi",
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta",
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "if command -v checkupdates >/dev/null 2>&1; then count=$(checkupdates 2>/dev/null | wc -l); elif command -v pacman >/dev/null 2>&1; then count=$(pacman -Qu 2>/dev/null | wc -l); else echo \"pacman n/a\"; exit; fi; echo \"$count outdated (pacman)\"",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
  ],
}
